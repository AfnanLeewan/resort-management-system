# ==================================
# Resort Management System — .env
# ==================================
# For local Docker development, you don't need this file at all.
# JWT keys are hardcoded in docker-compose.yml (they are not secret locally).
# Only override these if you need to change defaults.

# PostgreSQL superuser password (default: postgres)
# POSTGRES_PASSWORD=postgres

# Ports — change if defaults conflict with other services on your machine
# APP_PORT=80
# SUPABASE_PORT=8000
# STUDIO_PORT=3001
# POSTGRES_PORT=5432

# Set to true to use localStorage fallback instead of Supabase
# VITE_DEMO_MODE=false

# ------------------------------------------------------------------
# CLOUD SUPABASE (production only — not needed for local dev)
# ------------------------------------------------------------------
# To deploy against Supabase Cloud, build the app manually:
#   VITE_SUPABASE_URL=https://your-project.supabase.co \
#   VITE_SUPABASE_ANON_KEY=your-cloud-anon-key \
#   npm run build
